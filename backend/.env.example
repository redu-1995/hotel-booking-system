# SMTP values for local development; never put real credentials in this file.
MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAILER_HOST=smtp-relay.brevo.com
MAILER_PORT=587
MAILER_USERNAME=your_brevo_smtp_login
MAILER_PASSWORD=your_brevo_smtp_key
MAILER_USE_TLS=True
MAILER_TIMEOUT=20
DEFAULT_FROM_EMAIL=Hotel Reservations <verified-sender@example.com>
